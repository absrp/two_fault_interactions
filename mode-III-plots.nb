Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "function", " ", "that", " ", "makes", " ", "the", " ", "mesh", " ", 
    "finer", " ", "in", " ", "regions", " ", "with", " ", "high", " ", 
    "stress", " ", "concentration"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxCellMeasure", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vertices", ",", "area"}], "}"}], ",", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "=", 
           RowBox[{"Mean", "[", "vertices", "]"}]}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x", "-", 
                  RowBox[{"L", "/", "2"}]}], ")"}], "2"], "+", 
               SuperscriptBox["y", "2"]}], "<=", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"L", "/", "2"}], ")"}], "2"]}], "\[Or]", 
             RowBox[{
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x", "+", 
                  RowBox[{"L", "/", "2"}]}], ")"}], "2"], "+", 
               SuperscriptBox["y", "2"]}], "<=", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"L", "/", "2"}], ")"}], "2"]}], "\[Or]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"-", "L"}], "/", "2"}], "<", "x", "<", 
                 RowBox[{"L", "/", "2"}]}], ")"}], "\[And]", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", "L"}], "/", "2"}], "/", "2"}], "<", "y", "<", 
                 
                 RowBox[{
                  RowBox[{"L", "/", "2"}], "/", "2"}]}], ")"}]}], ")"}]}], ",", 
            RowBox[{"area", ">", 
             RowBox[{"0.0015", "/", "16"}]}], ",", 
            RowBox[{"area", ">", 
             RowBox[{
              RowBox[{"0.003", "/", "16"}], "*", " ", 
              RowBox[{"(", 
               RowBox[{"3.", "+", 
                RowBox[{"0.8", " ", 
                 RowBox[{"Norm", "[", 
                  RowBox[{"Mean", "[", "vertices", "]"}], "]"}]}]}], 
               ")"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}]}]}]], "Input",
