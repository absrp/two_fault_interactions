Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"build", " ", "CSdataRaw", " ", "as", " ", "a", " ", "list"}], 
   "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"CSdataRaw", "=", 
     RowBox[{"Quiet", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"CS", "[", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", 
          RowBox[{"L", "/", "2"}], ",", "f0"}], "]"}], "&"}], "/@", "xyTab"}],
       "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"replace", " ", "non"}], "-", 
     RowBox[{"JSON", " ", "values"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"CSdataForJSON", "=", 
     RowBox[{"CSdataRaw", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
