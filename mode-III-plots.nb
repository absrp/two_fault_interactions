Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "function", " ", "that", " ", "makes", " ", "the", " ", "mesh", " ", 
    "finer", " ", "in", " ", "regions", " ", "with", " ", "high", " ", 
    "stress", " ", "concentration"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxCellMeasure", "=", "500"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"vertices", ",", "area"}], "}"}], ",", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "y"}], "}"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", "y"}], "}"}], "=", 
           RowBox[{"Mean", "[", "vertices", "]"}]}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"x", "-", 
                  RowBox[{"L", "/", "2"}]}], ")"}], "2"], "+", 
               SuperscriptBox["y", "2"]}], "<=", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"L", "/", "2"}], ")"}], "2"]}], "\[Or]", 
