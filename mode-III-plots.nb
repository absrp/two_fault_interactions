Cell[CellGroupData[{

Cell["Relevant component of the stress tensor \[Sigma]", "Section",
 CellChangeTimes->{{3.947619689630147*^9, 3.947619697312192*^9}, {
   3.949577893566319*^9, 3.949577896630671*^9}, 3.9498595406574717`*^9, {
   3.956149798564784*^9, 3.956149804885571*^9}, {3.956426492608594*^9, 
   3.9564265017895737`*^9}, 
   3.956494071011159*^9},ExpressionUUID->"10a2e6c5-2115-41d1-838d-\
c75abecb398f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]yz", "[", 
    RowBox[{"x_", ",", "y_", ",", "l_", ",", "M_"}], "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["M", "1"], "-", 
         SuperscriptBox["l", "2"], "+", 
         SuperscriptBox["x", "2"], "-", 
         SuperscriptBox["y", "2"]}]]}], "+", 
      RowBox[{
       RowBox[{"Abs", "[", "y", "]"}], 
       SqrtBox[
        RowBox[{
         SuperscriptBox["M", "1"], "+", 
         SuperscriptBox["l", "2"], "-", 
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"]}]]}]}], 
     RowBox[{
      SqrtBox["2"], " ", "M"}]], "-", "1"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.941551838868577*^9, 3.941551855057849*^9}, {
  3.941551969298052*^9, 3.9415519700230513`*^9}, {3.941552110298565*^9, 
  3.941552126452644*^9}, {3.941553167358844*^9, 3.9415532234952707`*^9}, {
  3.9415731631141768`*^9, 3.941573166153263*^9}, {3.941573270739212*^9, 
  3.941573273167942*^9}, {3.941573321616042*^9, 3.941573370457738*^9}, {
  3.9415734483244658`*^9, 3.941573448477612*^9}, {3.941573487433468*^9, 
  3.941573487546967*^9}},
 CellLabel->
  "In[463]:=",ExpressionUUID->"e331b610-a2ce-487c-a4ae-c7b960beaab3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"M", "[", 
    RowBox[{"x_", ",", "y_", ",", "l_"}], "]"}], ":=", 
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "l"}], "+", "x"}], ")"}], "2"], "+", 
      SuperscriptBox["y", "2"]}]], 
    SqrtBox[
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"l", "+", "x"}], ")"}], "2"], "+", 
      SuperscriptBox["y", "2"]}]]}]}], ";"}]], "Input",
 CellLabel->
  "In[464]:=",ExpressionUUID->"cf9c64e6-5997-4862-b574-2aff5811f1da"],

Cell["\[OpenCurlyDoubleQuote]l\[CloseCurlyDoubleQuote] is half-crack length", \
"Text",
 CellChangeTimes->{{3.956494202864333*^9, 
  3.9564942098545227`*^9}},ExpressionUUID->"7fa32d0b-fe23-4c0c-9d0c-\
808b260f0777"]
}, Closed]],

Cell[CellGroupData[{

Cell["Coulomb stress change in parallel receiver faults", "Section",
 CellChangeTimes->{{3.947619689630147*^9, 3.947619697312192*^9}, {
  3.947620235694755*^9, 3.947620243005024*^9}, {3.956149814568617*^9, 
  3.956149837516521*^9}, {3.9561590953029623`*^9, 3.956159105214054*^9}, {
  3.956426651821159*^9, 
  3.956426652203198*^9}},ExpressionUUID->"3cdb6037-7c7b-423f-9aea-\
4fff3d3d3cc6"],

Cell[CellGroupData[{

Cell["Define Coulomb stress change on any parallel faults", "Subsection",
 CellChangeTimes->{{3.949858901233265*^9, 3.949858918671076*^9}, {
  3.9498595161267967`*^9, 3.949859534591558*^9}, {3.95614986272331*^9, 
  3.956149868954327*^9}, {3.956426677071795*^9, 3.9564266777290907`*^9}, {
  3.956433428580594*^9, 
  3.9564334291288652`*^9}},ExpressionUUID->"eb4636c9-b14f-45b8-8904-\
32cd7271814b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CS", "[", 
    RowBox[{"x_", ",", "y_", ",", "a_", ",", "f_"}], "]"}], ":=", 
   RowBox[{"\[Sigma]yz", "[", 
    RowBox[{"x", ",", "y", ",", "a", ",", 
     RowBox[{"M", "[", 
      RowBox[{"x", ",", "y", ",", "a"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"parallel", " ", "faults", " ", "are", " ", "along", " ", "x"}], ",",
     " ", 
    RowBox[{
     RowBox[{"\"\<a\>\"", " ", "is", " ", "half"}], "-", 
     RowBox[{"crack", " ", "length"}]}]}], " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.949859631150853*^9, 3.9498596627502127`*^9}, {
   3.949859903406871*^9, 3.949859928090301*^9}, {3.949860032679982*^9, 
   3.94986003455254*^9}, 3.949860109671414*^9, {3.949860436456994*^9, 
   3.949860437143052*^9}, {3.956426802059403*^9, 3.956426847078264*^9}, {
   3.956494221871356*^9, 3.956494246686631*^9}},
 CellLabel->
  "In[465]:=",ExpressionUUID->"0450cff1-f47f-40cf-a3ec-84c6617cea4e"],

Cell["\<\
Note that we are using classic solid mechanics convention
\[Sigma]yz is positive in the direction of slip of the receiver fault\
\>", "Text",
 CellChangeTimes->{{3.9498601199297333`*^9, 3.9498601695330267`*^9}, {
  3.94986045080284*^9, 3.949860487154854*^9}, {3.956494252322472*^9, 
  3.9564942660059643`*^9}},ExpressionUUID->"379dd993-34cc-4cf4-8e83-\
d231b57b3493"],

