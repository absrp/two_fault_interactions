Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"logPosNeg", "[", "C_", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Sign", "[", "x", "]"}], "*", 
    RowBox[{"Log10", "[", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "/", 
       RowBox[{"(", 
        SuperscriptBox["10", "C"], ")"}]}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.8753482506196404`*^9},
 CellLabel->
  "In[566]:=",ExpressionUUID->"de580221-4954-4ad4-8665-76ec68e1a577"],

