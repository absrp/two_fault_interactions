Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"logPosNeg", "[", "C_", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Sign", "[", "x", "]"}], "*", 
    RowBox[{"Log10", "[", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "/", 
       RowBox[{"(", 
        SuperscriptBox["10", "C"], ")"}]}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.8753482506196404`*^9},
 CellLabel->
  "In[665]:=",ExpressionUUID->"fe7197b3-1e3f-4f70-8c94-efb352ab536a"],

