Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"second", "-", 
    RowBox[{"plot", " ", "shift", " ", 
     RowBox[{"(", 
      RowBox[{"force", " ", "numeric"}], ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"shift2ForJSON", "=", 
     RowBox[{"N", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"L", "-", "p"}], ")"}], "/", "2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "build", " ", "triples", " ", "for", " ", "the", " ", "second", " ", 
     "density", " ", "plot", " ", 
     RowBox[{"(", 
      RowBox[{"NO", " ", "Transpose", " ", "issues"}], ")"}]}], "*)"}], "\n", 
   
   RowBox[{
    RowBox[{"dataCStoPlot2ForJSON", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "+", "shift2ForJSON"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "#2"}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"xyTab", ",", "CSdataCapped"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"JSON", " ", 
      RowBox[{"can", "'"}], "t", " ", "store", " ", 
      RowBox[{
       RowBox[{"Indeterminate", "/", "Infinity"}], "/", "Complex"}]}], ";", 
     RowBox[{"convert", " ", "to", " ", "Null"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dataCStoPlot2ForJSONClean", "=", 
     RowBox[{"dataCStoPlot2ForJSON", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Indeterminate", "|", "ComplexInfinity", "|", 
          RowBox[{"DirectedInfinity", "[", "_", "]"}]}], "->", "Null"}], ",", 
        
        RowBox[{
         RowBox[{"Infinity", "|", 
          RowBox[{"-", "Infinity"}]}], "->", "Null"}], ",", 
        RowBox[{"z_Complex", ":>", "Null"}]}], "}"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dataCStoPlot2ForJSONNoNull", "=", 
     RowBox[{"Select", "[", 
      RowBox[{"dataCStoPlot2ForJSONClean", ",", 
       RowBox[{
        RowBox[{"FreeQ", "[", 
         RowBox[{"#", ",", "Null"}], "]"}], "&"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<antiplane_partial_CS.json\>\"", ",", 
     "dataCStoPlot2ForJSONNoNull", ",", "\"\<JSON\>\""}], "]"}]}]}]], "Input",\

 CellChangeTimes->{{3.977254459480302*^9, 3.9772544675470943`*^9}, 
