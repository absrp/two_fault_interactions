Cell[CellGroupData[{

Cell["Relevant components of the stress tensor \[Sigma]", "Section",
 CellChangeTimes->{{3.947619689630147*^9, 3.947619697312192*^9}, {
   3.949577893566319*^9, 3.949577896630671*^9}, 3.9498595406574717`*^9, {
   3.956149798564784*^9, 3.956149804885571*^9}, {3.956426492608594*^9, 
   3.9564265017895737`*^9}},ExpressionUUID->"10a2e6c5-2115-41d1-838d-\
c75abecb398f"],

Cell[CellGroupData[{

Cell["\<\
We use Kolosov\[CloseCurlyQuote]s crack fields given in terms of complex \
potentials (for unit stress drop, crack is on on -a<x<a), plus the complex \
potentials given in Muskhelishvili\[CloseCurlyQuote]s book. \
\>", "Item",
 CellChangeTimes->{{3.941580425797677*^9, 3.94158044108688*^9}, {
  3.9415805300004253`*^9, 3.941580585235914*^9}, {3.9495779628773527`*^9, 
  3.94957805937263*^9}, {3.949578112014614*^9, 3.949578113347625*^9}, {
  3.9495784256300497`*^9, 3.949578433318063*^9}, {3.949858334731938*^9, 
  3.949858339498685*^9}},ExpressionUUID->"f1101980-01e1-409a-84f6-\
9fd8af18eaaf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PhiP", "[", 
    RowBox[{"z_", ",", "a_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"I", "*", 
     FractionBox["1", "2"]}], "-", 
    RowBox[{"I", "*", 
     FractionBox["1", "2"], 
     FractionBox["z", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"z", "-", "a"}], "]"}], 
       RowBox[{"Sqrt", "[", 
        RowBox[{"z", "+", "a"}], "]"}]}]]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PhiPP", "[", 
    RowBox[{"z_", ",", "a_"}], "]"}], ":=", 
   RowBox[{"I", "*", 
    FractionBox["1", "2"], 
    FractionBox[
     SuperscriptBox["a", "2"], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z", "-", "a"}], ")"}], 
       RowBox[{"3", "/", "2"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z", "+", "a"}], ")"}], 
       RowBox[{"3", "/", "2"}]]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"PsiP", "[", 
    RowBox[{"z_", ",", "a_"}], "]"}], ":=", 
   RowBox[{"I", "*", 
    FractionBox["1", "2"], 
    FractionBox[
     RowBox[{
      RowBox[{"2", 
       SuperscriptBox["z", "3"]}], "-", 
      RowBox[{"3", " ", "z", " ", 
       SuperscriptBox["a", "2"]}]}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z", "-", "a"}], ")"}], 
       RowBox[{"3", "/", "2"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z", "+", "a"}], ")"}], 
       RowBox[{"3", "/", "2"}]]}]]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9495780873485937`*^9, 3.9495780980352583`*^9}, {
   3.949578179358078*^9, 3.949578356711685*^9}, {3.949578401122281*^9, 
   3.949578527112349*^9}, 3.949858490847685*^9},
 CellLabel->
  "In[226]:=",ExpressionUUID->"d18e204f-8d6e-45f3-a2a4-3e1aa1714898"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[StyleBox["Shear component", "Item"]], "Item",
 CellChangeTimes->{
  3.956426551177796*^9},ExpressionUUID->"908c398d-f5e7-4840-8010-\
269d282f7d8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]12", "[", 
   RowBox[{"x_", ",", "y_", ",", "a_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "z", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"x", "+", 
       RowBox[{"I", "*", "y"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Im", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Conjugate", "[", "z", "]"}], "*", 
         RowBox[{"PhiPP", "[", 
          RowBox[{"z", ",", "a"}], "]"}]}], "+", 
        RowBox[{"PsiP", "[", 
         RowBox[{"z", ",", "a"}], "]"}]}], "]"}], "-", "1"}]}]}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "We", " ", "need", " ", "this", " ", "\"\<-1\>\"", " ", "to", " ", 
     "match", " ", "calculations", " ", "based", " ", "on", " ", 
     "distributed", " ", "dislocations"}], " ", "*)"}], "\[IndentingNewLine]",
    "]"}]}]], "Input",
 CellChangeTimes->{{3.949578531793174*^9, 3.9495786187129097`*^9}, {
  3.94957867473908*^9, 3.949578818586513*^9}, {3.949579081089023*^9, 
  3.94957908125664*^9}, {3.949579140547139*^9, 3.94957914073062*^9}, {
  3.94957949995791*^9, 3.9495795302653837`*^9}, {3.9495816247190523`*^9, 
  3.949581630490622*^9}, {3.949582545833359*^9, 3.94958256108388*^9}, {
  3.949775603577574*^9, 3.949775612514027*^9}, {3.9498583555149403`*^9, 
  3.949858411920094*^9}, {3.9564265734758177`*^9, 3.956426582792734*^9}},
 CellLabel->
  "In[229]:=",ExpressionUUID->"c42dac04-6f4c-4c59-a104-6708edda3480"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Normal component", "Item",
 CellChangeTimes->{
  3.9564266149729853`*^9},ExpressionUUID->"15ba90a0-edbd-4196-a4d9-\
b8a614be0ece"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]22", "[", 
   RowBox[{"x_", ",", "y_", ",", "a_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"z", ",", "eq1", ",", "eq2", ",", "s11", ",", "s22"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"z", "=", 
      RowBox[{"x", "+", 
       RowBox[{"I", "*", "y"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eq1", "=", 
      RowBox[{"s11", "+", "s22", "-", 
       RowBox[{"4", "*", 
        RowBox[{"Re", "[", 
         RowBox[{"PhiP", "[", 
          RowBox[{"z", ",", "a"}], "]"}], "]"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eq2", "=", 
      RowBox[{"s22", "-", "s11", "-", 
       RowBox[{"Re", "[", 
        RowBox[{"2", "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Conjugate", "[", "z", "]"}], "*", 
            RowBox[{"PhiPP", "[", 
             RowBox[{"z", ",", "a"}], "]"}]}], "+", 
           RowBox[{"PsiP", "[", 
            RowBox[{"z", ",", "a"}], "]"}]}], ")"}]}], "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"eq1", "==", "0"}], ",", 
             RowBox[{"eq2", "==", "0"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"s11", ",", "s22"}], "}"}]}], "]"}], "//", "Values"}], "//",
         "Flatten"}], ")"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.949579559832399*^9, 3.949579766069107*^9}, {
  3.949579796906493*^9, 3.94957991416969*^9}, {3.949580026187476*^9, 
  3.949580039139719*^9}, {3.94958030620492*^9, 3.94958030698382*^9}, {
  3.94958041282075*^9, 3.949580414194475*^9}},
 CellLabel->
  "In[230]:=",ExpressionUUID->"7e270831-5bfc-4ec4-890c-f7db749a2758"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Coulomb stress change in parallel receiver faults", "Section",
 CellChangeTimes->{{3.947619689630147*^9, 3.947619697312192*^9}, {
  3.947620235694755*^9, 3.947620243005024*^9}, {3.956149814568617*^9, 
  3.956149837516521*^9}, {3.9561590953029623`*^9, 3.956159105214054*^9}, {
  3.956426651821159*^9, 
  3.956426652203198*^9}},ExpressionUUID->"3cdb6037-7c7b-423f-9aea-\
4fff3d3d3cc6"],

Cell[CellGroupData[{

Cell["Define Coulomb stress change on any parallel faults", "Subsection",
 CellChangeTimes->{{3.949858901233265*^9, 3.949858918671076*^9}, {
  3.9498595161267967`*^9, 3.949859534591558*^9}, {3.95614986272331*^9, 
  3.956149868954327*^9}, {3.956426677071795*^9, 3.9564266777290907`*^9}, {
  3.956433428580594*^9, 
  3.9564334291288652`*^9}},ExpressionUUID->"eb4636c9-b14f-45b8-8904-\
32cd7271814b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CS", "[", 
    RowBox[{"x_", ",", "y_", ",", "a_", ",", "f_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"\[Sigma]12", "[", 
     RowBox[{"x", ",", "y", ",", "a"}], "]"}], "+", 
    RowBox[{"f", "*", 
     RowBox[{"\[Sigma]22", "[", 
      RowBox[{"x", ",", "y", ",", "a"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"parallel", " ", "faults", " ", "are", " ", "along", " ", "x"}], ",",
     " ", 
    RowBox[{
     RowBox[{"\"\<a\>\"", " ", "is", " ", "half"}], "-", 
     RowBox[{"crack", " ", "length"}]}], ",", " ", 
    RowBox[{"\"\<f\>\"", " ", "is", " ", "friction", " ", "coefficient"}]}], 
   " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.949859631150853*^9, 3.9498596627502127`*^9}, {
   3.949859903406871*^9, 3.949859928090301*^9}, {3.949860032679982*^9, 
   3.94986003455254*^9}, 3.949860109671414*^9, {3.949860436456994*^9, 
   3.949860437143052*^9}, {3.956426802059403*^9, 3.956426847078264*^9}},
 CellLabel->
  "In[231]:=",ExpressionUUID->"0450cff1-f47f-40cf-a3ec-84c6617cea4e"],

Cell["\<\
Note that we are using classic solid mechanics convention, i.e., normal \
stress positive in tension. Sorry to my geologists friends.
This is the reason why we have +f* and also \[Sigma]12 is positive in the \
direction of slip of the receiver fault\
\>", "Text",
 CellChangeTimes->{{3.9498601199297333`*^9, 3.9498601695330267`*^9}, {
  3.94986045080284*^9, 
  3.949860487154854*^9}},ExpressionUUID->"379dd993-34cc-4cf4-8e83-\
d231b57b3493"],

Cell[CellGroupData[{

Cell["\<\
