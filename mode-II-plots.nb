                RowBox[{"0.8", " ", 
                 RowBox[{"Norm", "[", 
                  RowBox[{"Mean", "[", "vertices", "]"}], "]"}]}]}], 
               ")"}]}]}]}], "]"}]}]}], "]"}]}], "]"}]}], ";"}]}]}]], "Input",
