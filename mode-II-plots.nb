Cell["To allow for negative values in log scale", "Text",
 CellChangeTimes->{{3.9564306714393587`*^9, 
  3.9564306776821413`*^9}},ExpressionUUID->"4d7d96cf-af32-45b2-a9d5-\
d1777010dd10"],

Cell["\<\
Source: https://jp.mathworks.com/matlabcentral/fileexchange/57902-symlog\
\>", "Text",
 CellChangeTimes->{{3.87534713892432*^9, 
  3.875347141072378*^9}},ExpressionUUID->"b309a119-9cea-4006-9140-\
9cd7f5eaddb9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"logPosNeg", "[", "C_", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Sign", "[", "x", "]"}], "*", 
    RowBox[{"Log10", "[", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "/", 
       RowBox[{"(", 
        SuperscriptBox["10", "C"], ")"}]}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.8753482506196404`*^9},
 CellLabel->
  "In[323]:=",ExpressionUUID->"de580221-4954-4ad4-8665-76ec68e1a577"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"CS", "[", 
        RowBox[{"x", ",", 
         RowBox[{"distanceFaults", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"L", "/", "2."}], ",", "f0"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"-", "L"}], "/", "2"}], ",", 
         RowBox[{"L", "/", "2"}]}], "}"}], ",", 
       RowBox[{"ScalingFunctions", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"logPosNeg", "[", 
           RowBox[{"minExp", "-", "1"}], "]"}], ",", 
          RowBox[{"logPosNeg", "[", 
           RowBox[{"minExp", "-", "1"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"Axes", "->", 
        RowBox[{"{", 
         RowBox[{"False", ",", "False"}], "}"}]}], ",", 
       RowBox[{"FrameTicks", "\[Rule]", 
        RowBox[{"{", 
