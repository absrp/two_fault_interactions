     RowBox[{"CSdataRaw", "/.", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Indeterminate", "|", "ComplexInfinity", "|", 
          RowBox[{"DirectedInfinity", "[", "_", "]"}]}], "->", "Null"}], ",", 
        
        RowBox[{"Infinity", "->", "Null"}], ",", 
        RowBox[{
         RowBox[{"-", "Infinity"}], "->", "Null"}]}], "}"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"make", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "cs"}], "}"}], " ", "triples", " ", 
     "without", " ", "Transpose"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataCStoPlotForJSON", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#1", "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", 
          RowBox[{"#1", "[", 
           RowBox[{"[", "2", "]"}], "]"}], ",", "#2"}], "}"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"xyTab", ",", "CSdataForJSON"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<inplane_full_CS.json\>\"", ",", "dataCStoPlotForJSON", 
     ",", "\"\<JSON\>\""}], "]"}], "\n", "\n"}]}]], "Input",
