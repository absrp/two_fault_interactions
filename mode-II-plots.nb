Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"logPosNeg", "[", "C_", "]"}], "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Sign", "[", "x", "]"}], "*", 
    RowBox[{"Log10", "[", 
     RowBox[{"1", "+", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "/", 
       RowBox[{"(", 
        SuperscriptBox["10", "C"], ")"}]}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.8753482506196404`*^9},
 CellLabel->
  "In[346]:=",ExpressionUUID->"fe312479-61d8-4f07-baf8-0b994afa80af"],

