Cell[CellGroupData[{

Cell["\<\
Calculation of CS including a cap at too high (+limit) or too low (-limit) CS\
\
\>", "Item",
 CellChangeTimes->{{3.956427127366205*^9, 3.9564271509792547`*^9}, {
  3.956427348505673*^9, 
  3.956427393911786*^9}},ExpressionUUID->"b75a24da-2403-4559-976f-\
2e9d1e14d0e5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"limit", "=", "0.4"}], ";"}]], "Input",
 CellChangeTimes->{{3.9561456852563334`*^9, 3.9561456908324757`*^9}},
 CellLabel->
  "In[285]:=",ExpressionUUID->"9080e8ce-e3e1-4b19-8236-8d6991def42d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CSdata", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"CS", "[", 
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"#", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", 
        RowBox[{"L", "/", "2"}], ",", "f0"}], "]"}], "&"}], "/@", "xyTab"}]}],
    ";"}], "//", "AbsoluteTiming"}]], "Input",
 CellChangeTimes->{{3.956146671650344*^9, 3.956146700964551*^9}, {
  3.956146756973475*^9, 3.956146776987342*^9}, {3.9561532483751383`*^9, 
  3.956153248790524*^9}, {3.956427437200918*^9, 3.956427449127117*^9}},
 CellLabel->
  "In[286]:=",ExpressionUUID->"92e5e014-c10e-40d0-b667-3eb1d9509a88"],

Cell[BoxData[
 TemplateBox[{
  "Power", "infy", 
   "\"Infinite expression \\!\\(\\*FractionBox[\\\"1\\\", \
RowBox[{RowBox[{\\\"0.`\\\", \\\"\[VeryThinSpace]\\\"}], \\\"+\\\", \
RowBox[{\\\"0.`\\\", \\\" \\\", \\\"\[ImaginaryI]\\\"}]}]]\\) encountered.\"",
    2, 286, 14, 27852989649038361007, "Local"},
  "MessageTemplate",
  BaseStyle->"MSG"]], "Message",
 CellChangeTimes->{3.960309724989923*^9, 3.968801511578369*^9, 
